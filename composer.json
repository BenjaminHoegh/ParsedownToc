{
    "name": "benjaminhoegh/parsedown-toc",
    "description": "Table of Contents Extension for Parsedown.",
    "keywords": [
        "markdown",
        "parser",
        "extension"
    ],
    "homepage": "https://github.com/BenjaminHoegh/parsedownToc/",
    "authors": [
        {
            "name": "BenjaminHoegh",
            "homepage": "https://github.com/BenjaminHoegh/",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "erusev/parsedown": "^1.8",
        "erusev/parsedown-extra": "^0.9"
    },
    "autoload": {
        "psr-0": {
            "": [
                "src/",
                "tests/"
            ]
        }
    },
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "archive": {
        "exclude": [
            "/tests",
            "/phpunit.xml",
            "/psalm.xml"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "vimeo/psalm": ">=6.16.1",
        "friendsofphp/php-cs-fixer": "^3.95"
    }
}
